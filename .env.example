# TiDB demo connection. Existing .env credentials can be reused.
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=4000
DB_TLS=verify
SSL_CA=
TIDB_DEMO_DATABASE=fraud_detection_demo

# Dashboard
IEEE_CIS_DATA_DIR=data/raw/ieee_cis
DASHBOARD_ARTIFACT_DIR=artifacts/dashboard

# Chatbot API
# Export these in the process only for optional general Gemini answers.
GEMINI_API_KEY=
GEMINI_MODEL=
PORT=5000
